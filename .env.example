# Where the site lives. Used in emails and absolute links.
NEXT_PUBLIC_SITE_URL=https://joinoffcut.com

# Supabase — server-only. Create a project at https://supabase.com.
# URL and service role key are under Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# Resend — server-only. Get an API key at https://resend.com/api-keys.
# Verify joinoffcut.com as a sending domain to use a from address on it.
RESEND_API_KEY=re_...

# Where submission notifications get emailed.
ADMIN_EMAIL=tjgarcia0427@gmail.com

# Sender for transactional mail. Once joinoffcut.com is verified in Resend,
# you can switch this to e.g. "OFFCUT <hello@joinoffcut.com>".
RESEND_FROM="OFFCUT <onboarding@resend.dev>"

# Admin panel password. Username is "admin". Pick anything; rotate freely.
ADMIN_PASSWORD=change-me-now
